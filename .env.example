# =====================================================================
# Sprawler - Business-Knowledge Web Crawler Configuration
# =====================================================================

# Service & Network
SPRAWLER_APP_NAME=sprawler
SPRAWLER_DEBUG=false
SPRAWLER_API_HOST=0.0.0.0
SPRAWLER_API_PORT=8000
SPRAWLER_DATA_DIR=./data
SPRAWLER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36 (compatible; Sprawler/1.0; +https://github.com/sprawler/sprawler)"
SPRAWLER_REQUEST_TIMEOUT=20.0
SPRAWLER_CONNECT_TIMEOUT=10.0

# Crawl Limits & Frontier
SPRAWLER_MAX_CONCURRENCY=5
SPRAWLER_MAX_PAGES_PER_SITE=200
SPRAWLER_MAX_DEPTH=4
SPRAWLER_MAX_PAGE_SIZE_BYTES=10485760
SPRAWLER_POLITENESS_DELAY_SECONDS=0.5
SPRAWLER_HONOR_CRAWL_DELAY=true

# Discovery & Scope
SPRAWLER_ALLOW_SUBDOMAINS=true
SPRAWLER_USE_CRTSH=false
SPRAWLER_CRTSH_TIMEOUT_SECONDS=10.0

# Browser & Playwright
SPRAWLER_FORCE_BROWSER=false
SPRAWLER_BROWSER_HEADLESS=true
SPRAWLER_BROWSER_TIMEOUT_MS=30000
SPRAWLER_NETWORKIDLE_TIMEOUT_MS=10000
SPRAWLER_DOM_QUIET_WINDOW_MS=500
SPRAWLER_DISMISS_CONSENT_WALLS=true

# Resilience & Circuit Breaker
SPRAWLER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SPRAWLER_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60.0
SPRAWLER_CIRCUIT_BREAKER_HALF_OPEN_SUCCESS_THRESHOLD=2
SPRAWLER_RETRY_MAX_ATTEMPTS=3
SPRAWLER_RETRY_MIN_WAIT_SECONDS=1.0
SPRAWLER_RETRY_MAX_WAIT_SECONDS=10.0

# Text Normalization & Persian Language
# Target digits: 'latin' (0-9), 'persian' (۰-۹), or 'keep'
SPRAWLER_PERSIAN_NORMALIZE_DIGITS=latin
SPRAWLER_UNIFY_ZWNJ=true

# OCR & PDF Processing
SPRAWLER_MAX_PDF_SIZE_BYTES=15728640
SPRAWLER_OCR_ENABLED_FOR_PDF=true
SPRAWLER_OCR_ENABLED_FOR_IMAGES=false
SPRAWLER_OCR_LANGUAGES=fas+eng
